@startuml
skinparam style strictuml
skinparam sequenceMessageAlign center
autonumber

participant "Current Client" as C
participant "Server" as S
participant "Broadcast (All Clients)" as B

== ActionResolutionState Entry ==

S ->> B: onPhaseChanged(phase: PhaseType.ACTION_RESOLUTION, currentPlayer: String, resolutionOrder: List<String>)

note over S: Server notifies PhaseObservers\nBuildingEffects with ACTION_RESOLUTION effects activate

loop for each active BuildingEffect (PhaseObserver)
    S ->> B: onPlayerResourceChanged(nickname: String, resource: String, newValue: int, delta: int)
end

note right S: Notify limits for the first player in order
S ->> B: onPlayerLimitsInitialized(nickname: String, remainingUpper: int, remainingLower: int)

== Selection of Cards (resolveActions) ==

loop multiple times possible (incremental picks)
    C -> S: resolveActions(nickname: String, selectedIDs: List<String>)

    alt Success
        note over S: processActionSelection()

        opt First invocation for this player (isFoodResolved == false)
            S ->> B: onPlayerResourceChanged(nickname, "FOOD", newValue, delta)
        end

        loop for each CHARACTER card in selection
            S ->> B: onCardTaken(nickname, cardID, "CHARACTER", sourceRow)

            group insertCharacter(cardID)
                note over S: 1. Internal Update: Add card to Tribu data

                note over S: 2. Notify TribuObservers (Buildings)\nBuilding checks new counts (Sets/Pairs)
                opt If Building effect triggers (e.g., Set Completed)
                    S ->> B: onPlayerResourceChanged(nickname, resource, newValue, delta)
                end

                note over S: 3. Apply Character Specific Effect
                opt If Character effect triggers change
                    S ->> B: onPlayerResourceChanged(nickname, resource, newValue, delta)
                end
            end
        end

        loop for each BUILDING card in selection
            S ->> B: onPlayerResourceChanged(nickname: String, resource: "FOOD", newValue: int, delta: int)
            S ->> B: onCardTaken(nickname, cardID, "BUILDING", sourceRow)
            note right S: Optional effects triggered by observers\nnotified via onPlayerResourceChanged
        end

        S ->> B: onPlayerLimitsUpdated(nickname, remainingUpper, remainingLower)

    else Failure (Insufficient food, wrong turn, invalid IDs, Event cards)
        S --> C: onError(errorMessage: String)
    end
end

== Return to TurnOrderTile (moveTotem) ==

C -> S: moveTotem(nickname: String, tileID: 'T')

alt Success (Pick obligation met: remainingUpper == 0 && remainingLower == 0)
    note over S: movePlayerToTurnOrder(player)\nTransition to EndPlayerTurnState
    S ->> B: onTotemReturned(nickname: String, turnOrderPosition: int)
else Failure (Incomplete picks, tileID != 'T', or wrong turn)
    S --> C: onError(errorMessage: String)
end
@enduml