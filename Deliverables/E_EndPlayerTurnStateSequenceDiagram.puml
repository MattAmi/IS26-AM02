@startuml
skinparam style strictuml
skinparam sequenceMessageAlign center
autonumber

participant "Server" as S
participant "Broadcast (All Clients)" as B

== EndPlayerTurnState Entry ==

S ->> B: onPhaseChanged(phase: PhaseType.END_PLAYER_TURN)

note over S: Server notifies PhaseObservers\nBuildingEffects with END_PLAYER_TURN effects activate

loop for each active BuildingEffect (PhaseObserver)
    S ->> B: onPlayerResourceChanged(nickname: String, resource: String, newValue: int, delta: int)
end

note over S: EndPlayerTurnState.onEntryActions() triggered

== Position Rewards/Penalties ==

note over S: executeEndTurnRewards(player)

alt Player receives bonus food
    S ->> B: onPlayerResourceChanged(nickname: String, resource: "FOOD", newValue: int, delta: int)

else Last player pays 1 food (has food)
    S ->> B: onPlayerResourceChanged(nickname: String, resource: "FOOD", newValue: int, delta: -1)

else Last player has no food (loses Prestige Points)
    S ->> B: onPlayerResourceChanged(nickname: String, resource: "PRESTIGE_POINTS", newValue: int, delta: -2)
end

== Transition ==

S -> S: checkAllTotemsReturned()

alt Not all totems returned (false)
    note over S: game.nextPlayer()\ngameBoard.initializePlayerLimits(nextPlayer)

    S ->> B: onPhaseChanged(phase: PhaseType.ACTION_RESOLUTION, currentPlayer: String)

    note over S: Server notifies PhaseObservers\nBuildingEffects with ACTION_RESOLUTION effects activate

    loop for each active BuildingEffect (PhaseObserver)
        S ->> B: onPlayerResourceChanged(nickname: String, resource: String, newValue: int, delta: int)
    end

    S ->> B: onPlayerLimitsInitialized(nickname: String, remainingUpper: int, remainingLower: int)

else All totems returned (true)
    note over S: Transition to EndRoundState
    note right S: See EndRoundState diagram
end

@enduml