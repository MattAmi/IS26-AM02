@startuml
skinparam style strictuml
skinparam sequenceMessageAlign center
autonumber

participant "Extra Player Client" as C
participant "Server" as S
participant "Broadcast (All Clients)" as B

== Extra Turn Management ==

note over S: BuildingEffect triggers: game.enqueueExtraTurn(nickname, upper, lower)

... Game reaches EndRoundState ...

note over S: EndRoundState.onEntryActions() checks extraTurnPlayerNickname != null

alt isExtraTurnMode == true
    note over S: Set currentPlayerNickname\nInitialize temporary limits\nSuppress PhaseObserver notifications

    S ->> B: onExtraTurnStarted(nickname: String, extraTurnRemainingUpper: int, extraTurnRemainingLower: int)

    loop Incremental resolveActions
        C -> S: resolveActions(nickname: String, selectedIDs: List<String>)
        note over S: processExtraActionSelection()\n(Ignores OfferTile, uses temporary limits)

        alt Success
            S ->> B: onCardTaken(nickname, cardID, type, sourceRow)
            S ->> B: onPlayerResourceChanged(nickname, resource, newValue, delta)
            S ->> B: onPlayerLimitsUpdated(nickname, remainingUpper, remainingLower)
        else Failure
            S --> C: onError(errorMessage: String)
        end
    end

    C -> S: moveTotem(nickname: String, tileID: 'T')

    alt Success (Picks satisfied)
        S ->> B: onExtraTurnEnded(nickname: String)
        note over S: isExtraTurnMode = false\nextraTurnPlayerNickname = null

        note right S: Proceed to EventResolutionState\nor NewRoundState
    else Failure
        S --> C: onError(errorMessage: String)
    end

else No Extra Turn
    note right S: Proceed with standard EndRound flow\n(Events or New Round)
end

@enduml