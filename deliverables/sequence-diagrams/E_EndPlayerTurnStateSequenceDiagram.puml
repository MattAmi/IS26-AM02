@startuml
skinparam style strictuml
skinparam sequenceMessageAlign center
autonumber

participant "Server" as S
participant "Broadcast (All Clients)" as B

== EndPlayerTurnState Entry ==

note over S: onEntry(): notifyPhaseObservers(END_PLAYER_TURN) before onEntryActions()
loop for each active BuildingEffect (PhaseObserver)
    S ->> B: notifyPlayerResourceChanged(nickname, resource, newValue, delta)
end
note right S: No notifyPhaseChanged(END_PLAYER_TURN) is emitted.

== Position Rewards / Penalties (applyTurnOrderRewards) ==

opt foodGained > 0
    S ->> B: notifyPlayerResourceChanged(nickname, FOOD, newValue, +foodGained)
end
opt foodPenalty > 0 (last player pays food)
    S ->> B: notifyPlayerResourceChanged(nickname, FOOD, newValue, -foodPenalty)
end
opt ppPenalty > 0 (last player has no food — loses Prestige Points)
    S ->> B: notifyPlayerResourceChanged(nickname, PRESTIGE_POINTS, newValue, -ppPenalty)
end

== Transition ==

note over S: checkAllTotemsReturned()
alt Not all totems returned (false)
    note over S: nextPlayer()
    S ->> B: notifyCurrentPlayerChanged(nextPlayer: String)
    note over S: initializePlayerLimits(nextPlayer)
    S ->> B: notifyPlayerLimitsInitialized(nickname, remainingUpper, remainingLower)
    note over S: transitionTo(ActionResolutionState)\nnotifyPhaseObservers(ACTION_RESOLUTION)
    loop for each active BuildingEffect (PhaseObserver)
        S ->> B: notifyPlayerResourceChanged(nickname, resource, newValue, delta)
    end
    note right S: See ActionResolutionState diagram (D)
else All totems returned (true)
    note right S: transitionTo(EndRoundState) — see diagram F
end
@enduml